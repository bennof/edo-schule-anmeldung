#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if ! getent passwd edo-anmeldung-server >/dev/null; then
        useradd --system --user-group --no-create-home --home-dir /nonexistent \
            --shell /usr/sbin/nologin edo-anmeldung-server
    fi
    chown root:root /etc/edo-anmeldung-server/config.env
    chmod 600 /etc/edo-anmeldung-server/config.env
    # nginx snippet: only when nginx is installed; a changed snippet is kept,
    # the new version is placed next to it as .dpkg-dist
    snippet=/usr/share/edo-anmeldung-server/nginx/edo-anmeldung.conf
    target=/etc/nginx/snippets/edo-anmeldung.conf
    if [ -d /etc/nginx/snippets ]; then
        if [ ! -e "$target" ]; then
            install -m 644 "$snippet" "$target"
            echo "edo-anmeldung-server: nginx snippet installed: $target"
        elif ! cmp -s "$snippet" "$target"; then
            install -m 644 "$snippet" "$target.dpkg-dist"
            echo "edo-anmeldung-server: $target was changed, new version in $target.dpkg-dist"
        fi
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null || true
        # an update restarts a running server, a new install does not start it
        if systemctl is-active --quiet edo-anmeldung-server; then systemctl restart edo-anmeldung-server; fi
    fi
    if [ -z "$2" ]; then
        echo "edo-anmeldung-server: settings in /etc/edo-anmeldung-server/config.env,"
        echo "then: systemctl enable --now edo-anmeldung-server"
    fi
fi
