{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anmeldung.local/form.schema.json",
  "title": "FormDefinition",
  "description": "Versioned form format (backlog C1). Contains data structure and rules only, no HTML or PDF layout.",
  "type": "object",
  "required": ["formatVersion", "title", "sections"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "groups": {
      "description": "Reusable group definitions, referenced by group items.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/groupDefinition" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_]*$"
    },
    "text": { "type": "string", "minLength": 1 },
    "section": {
      "type": "object",
      "required": ["id", "title", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "description": { "type": "string" },
        "visibleIf": { "$ref": "#/$defs/condition" },
        "items": { "$ref": "#/$defs/items" }
      }
    },
    "groupDefinition": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "items": { "$ref": "#/$defs/items" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/field" }, { "$ref": "#/$defs/group" }]
      }
    },
    "group": {
      "description": "Instance of a reusable group. Data is an object, or an array of objects when repeatable.",
      "type": "object",
      "required": ["kind", "id", "group", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "group" },
        "id": { "$ref": "#/$defs/id" },
        "group": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text" },
        "visibleIf": { "$ref": "#/$defs/condition" },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minItems": { "type": "integer", "minimum": 0 },
            "maxItems": { "type": "integer", "minimum": 1 },
            "itemLabel": { "type": "string" }
          }
        },
        "copyFrom": {
          "description": "Ids of other instances of the same group whose values may be copied once into this one.",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["kind", "id", "type", "label"],
      "properties": {
        "kind": { "const": "field" },
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["text", "email", "phone", "date", "year", "integer", "boolean", "select", "multiselect", "searchselect"]
        },
        "label": { "$ref": "#/$defs/text" },
        "help": { "type": "string" },
        "required": { "type": "boolean" },
        "requiredIf": { "$ref": "#/$defs/condition" },
        "visibleIf": { "$ref": "#/$defs/condition" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" },
        "min": { "type": ["integer", "string"] },
        "max": { "type": ["integer", "string"] },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/option" }
        },
        "optionsSource": {
          "description": "Asset key of a JSON option list (e.g. a catalog), alternative to inline options.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["select", "multiselect", "searchselect"] } } },
          "then": {
            "oneOf": [{ "required": ["options"] }, { "required": ["optionsSource"] }]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["options"] },
                { "required": ["optionsSource"] },
                { "required": ["minItems"] },
                { "required": ["maxItems"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["text", "email", "phone"] } } },
          "else": {
            "not": {
              "anyOf": [{ "required": ["minLength"] }, { "required": ["maxLength"] }, { "required": ["pattern"] }]
            }
          }
        },
        {
          "if": { "properties": { "type": { "enum": ["integer", "year"] } } },
          "then": { "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } } },
          "else": {
            "if": { "properties": { "type": { "const": "date" } } },
            "then": {
              "properties": {
                "min": { "$ref": "#/$defs/date" },
                "max": { "$ref": "#/$defs/date" }
              }
            },
            "else": { "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }] } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "multiselect" } } },
          "else": { "not": { "anyOf": [{ "required": ["minItems"] }, { "required": ["maxItems"] }] } }
        }
      ]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "option": {
      "type": "object",
      "required": ["key", "value"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "condition": {
      "description": "Field references are sibling ids in the current scope, or absolute paths starting with '/' through group ids, sections are not part of the path (e.g. '/sorgeberechtigter1/nachname').",
      "oneOf": [
        {
          "type": "object",
          "required": ["field", "equals"],
          "additionalProperties": false,
          "properties": { "field": { "$ref": "#/$defs/fieldRef" }, "equals": { "$ref": "#/$defs/scalar" } }
        },
        {
          "type": "object",
          "required": ["field", "notEquals"],
          "additionalProperties": false,
          "properties": { "field": { "$ref": "#/$defs/fieldRef" }, "notEquals": { "$ref": "#/$defs/scalar" } }
        },
        {
          "type": "object",
          "required": ["field", "in"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/fieldRef" },
            "in": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } }
          }
        },
        {
          "type": "object",
          "required": ["field", "filled"],
          "additionalProperties": false,
          "properties": { "field": { "$ref": "#/$defs/fieldRef" }, "filled": { "type": "boolean" } }
        },
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
        },
        {
          "type": "object",
          "required": ["not"],
          "additionalProperties": false,
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "fieldRef": {
      "type": "string",
      "pattern": "^(/[a-z][a-zA-Z0-9_]*)+$|^[a-z][a-zA-Z0-9_]*$"
    },
    "scalar": { "type": ["string", "number", "boolean"] }
  }
}
