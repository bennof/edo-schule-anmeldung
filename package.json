{
  "name": "edo-schule-anmeldung",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dev:public": "pnpm --filter @anmeldung/public dev",
    "dev:secretariat": "pnpm --filter @anmeldung/secretariat dev",
    "test:integration": "node scripts/integration-test.ts && node scripts/integration-public-api.ts",
    "test:e2e": "node scripts/e2e-login.ts && node scripts/e2e-forms.ts && node scripts/e2e-secretariat.ts && node scripts/e2e-booking.ts && node scripts/e2e-registration.ts && node scripts/e2e-day.ts",
    "dev:server": "cd server && cargo run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.19.1",
    "playwright-core": "^1.63.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
