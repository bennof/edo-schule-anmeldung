{
  "name": "edo-schule-anmeldung",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build && pnpm build:server && pnpm build:desktop",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml",
    "build:desktop": "cargo build --release --manifest-path desktop/Cargo.toml",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dev:public": "pnpm --filter @anmeldung/public dev",
    "dev:secretariat": "pnpm --filter @anmeldung/secretariat dev",
    "dev:server": "cd server && cargo run",
    "dev:desktop": "pnpm --filter @anmeldung/secretariat build && cd desktop && cargo run"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.19.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "author": "Benjamin Benno Falkner <benno@falkner.xyz>",
  "license": "MIT"
}
